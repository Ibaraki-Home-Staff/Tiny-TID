# 駅すぱあとAPI設定
EKISPERT_API_KEY=your_api_key_here
STATION_CODE=25834

# キャッシュ設定
CACHE_DIR=./cache

# JR西日本リアルタイム設定
# WJRC_AREA: カンマ区切りで複数エリア指定可能 (kinki, hokuriku, okayama, hiroshima, sanin)
WJRC_AREA=kinki
WJRC_LINE=kyoto,hokurikubiwako,kosei,kobesanyo
WJRC_STCODE=0410
WJRC_POLLING_INTERVAL=10
WJRC_LINE_INTERVAL=2
